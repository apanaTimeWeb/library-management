{
  "info": {
    "name": "Admin - CRM Enquiries",
    "description": "Postman collection for Admin CRM Enquiries module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Enquiries",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/crm/enquiries",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "crm", "enquiries"]
        }
      }
    },
    {
      "name": "Get Enquiry By ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/admin/crm/enquiries/:id",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "crm", "enquiries", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "uuid-here"
            }
          ]
        }
      }
    },
    {
      "name": "Update Enquiry Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"converted\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/admin/crm/enquiries/:id/status",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "crm", "enquiries", ":id", "status"],
          "variable": [
            {
              "key": "id",
              "value": "uuid-here"
            }
          ]
        }
      }
    },
    {
      "name": "Add Follow Up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Called customer, will join next week\",\n  \"nextFollowUpDate\": \"2026-07-20T10:00:00Z\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/admin/crm/enquiries/:id/follow-ups",
          "host": ["{{base_url}}"],
          "path": ["api", "admin", "crm", "enquiries", ":id", "follow-ups"],
          "variable": [
            {
              "key": "id",
              "value": "uuid-here"
            }
          ]
        }
      }
    }
  ]
}